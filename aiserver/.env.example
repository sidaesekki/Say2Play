# 이 파일을 .env로 복사한 뒤 키를 넣으세요. .env는 git에 올라가지 않아요.
# 키 발급: https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# 모델 버전 고정. jev-latest는 새 버전이 나오면 바뀌어요.
TYPESAFE_DEFAULT_MODEL=jev-1.13.0

# 음성 인식 서버(voice_server.py) 설정이에요. server.py는 쓰지 않아요.
# 음성 인식 모델. 비워 두면 mlx-community/whisper-small-mlx(약 0.5GB)를 써요.
# 더 정확한 모델: mlx-community/whisper-large-v3-turbo (약 1.6GB)
STT_MODEL=
# 음성 인식 서버를 부를 수 있는 브라우저 주소. 쉼표로 구분하고, 비워 두면 모두 허용해요.
# 예: http://localhost:5173,http://localhost:8080
CORS_ORIGINS=
